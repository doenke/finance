# finance – Konfiguration
#
#   cp .env.example .env
#
# Pflicht für den ersten Start sind nur die Werte im Abschnitt „Grundlagen“.
# Alles darunter wird erst mit späteren Versionen genutzt. Du kannst es aber
# jetzt schon ausfüllen, dann musst du beim Update nichts mehr ändern.
# Erzeugte Geheimnisse nach dem ersten Start nicht mehr ändern.

# ---------------------------------------------------------------------------
# Grundlagen (jetzt nötig)
# ---------------------------------------------------------------------------

# Öffentliche Adresse, genau so wie sie im Browser steht (ohne / am Ende).
PUBLIC_URL=https://finance.example.org

# Passwort der Datenbank. Nur Buchstaben und Ziffern, weil es in einer URL steht:
#   openssl rand -hex 32
POSTGRES_PASSWORD=

# Port und Zeitzone stehen in compose.yml (PORT=43651, TZ=Europe/Berlin).
# Für die lokale Entwicklung ohne Compose:
# PORT=43651
# DATABASE_URL=postgresql://finance:<passwort>@127.0.0.1:5432/finance
# DATA_DIR=./data

# ---------------------------------------------------------------------------
# Sicherheit (ab der Version mit Login)
# ---------------------------------------------------------------------------

# Signiert die Session-Cookies. Ändern meldet alle ab.
#   openssl rand -base64 32
SESSION_KEY=

# Verschlüsselt gespeicherte Bank-PINs und API-Keys (AES-256-GCM).
# NIE ändern und gut aufheben – ohne diesen Schlüssel sind gespeicherte PINs
# verloren (auch im Backup). 32 Byte als Base64:
#   openssl rand -base64 32
SECRETS_KEY=

# Nur auf true setzen, wenn die App hinter einem Reverse Proxy (NPM) läuft,
# damit X-Forwarded-For/-Proto ausgewertet werden.
TRUSTED_PROXY=true

# ---------------------------------------------------------------------------
# Login über OIDC – Pocket ID (ab der Version mit Login)
# ---------------------------------------------------------------------------
# In Pocket ID einen OIDC-Client „finance“ anlegen:
#   Callback-URL:  ${PUBLIC_URL}/auth/callback
#   Public Client mit PKCE
#   „Allowed User Groups“: nur die Gruppe eures Haushalts

OIDC_ISSUER=https://id.example.org
OIDC_CLIENT_ID=
# Leer lassen bei einem öffentlichen Client (PKCE).
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email groups
# Mitglieder dieser Gruppe sehen die Admin-Funktionen (Einstellungen, Backup).
OIDC_ADMIN_GROUP=admins
# Name des Anbieters auf dem Anmeldeknopf.
OIDC_PROVIDER_NAME=Kanonenwiese SSO
# Erlaubte Hosts für Profilbilder (Standard: Host des Issuers), kommagetrennt.
# AVATAR_HOSTS=

# Nur für die lokale Entwicklung: Anmeldung ohne Identity Provider.
# NIEMALS in Produktion.
# DEV_LOGIN=true

# ---------------------------------------------------------------------------
# Bankanbindung FinTS (ab Stufe 1b)
# ---------------------------------------------------------------------------

# Registrierungsnummer der Deutschen Kreditwirtschaft (Produktregistrierung,
# Kategorie „Web-Server“). Ohne sie ist kein FinTS-Abruf möglich.
FINTS_PRODUCT_ID=
# Automatischer Abruf für Bankzugänge mit gespeicherter PIN (Cron, Europe/Berlin).
FINTS_SYNC_SCHEDULE=15 5 * * *

# ---------------------------------------------------------------------------
# Kurse
# ---------------------------------------------------------------------------

# Täglicher Kursabruf (Cron, Europe/Berlin). Nach Börsenschluss in den USA.
PRICE_SYNC_SCHEDULE=30 23 * * 1-5
# Ab wie vielen Handelstagen ohne neuen Kurs ein Wert als veraltet gilt.
PRICE_STALE_DAYS=3
# Yahoo Finance braucht keinen Schlüssel. Weitere Anbieter folgen, z. B.:
# EODHD_API_KEY=
# TWELVEDATA_API_KEY=
# COINGECKO_API_KEY=

# ---------------------------------------------------------------------------
# Backup (ab der Version mit Daten)
# ---------------------------------------------------------------------------

# Tägliches pg_dump nach /data/backup (Cron, Europe/Berlin).
BACKUP_SCHEDULE=30 3 * * *
# Aufbewahrung in Tagen.
BACKUP_KEEP_DAYS=30

# ---------------------------------------------------------------------------
# Benachrichtigungen (Phase 2)
# ---------------------------------------------------------------------------

# E-Mail über SMTP (Monatsbericht, Warnungen).
SMTP_HOST=
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=finance <finance@example.org>

# Web-Push (VAPID). Wie das Schlüsselpaar erzeugt wird, steht ab Phase 2 in
# der README. Einmal gesetzt nicht mehr ändern, sonst müssen sich alle Geräte
# neu für Benachrichtigungen anmelden.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org

# Monatsbericht am 1. jedes Monats (Cron, Europe/Berlin).
REPORT_SCHEDULE=0 8 1 * *

# ---------------------------------------------------------------------------
# Sonstiges
# ---------------------------------------------------------------------------

# debug | info | warning | error
LOG_LEVEL=info
