# finanzen – Konfiguration
#
#   cp .env.example .env
#
# Pflicht sind die Abschnitte „Grundlagen“, „Sicherheit“ und „Login“.
# Alles darunter ist optional: Bankabruf, Kurse, Backup und Benachrichtigungen
# laufen, sobald die jeweiligen Werte gesetzt sind.
# Erzeugte Geheimnisse nach dem ersten Start nicht mehr ändern.

# ---------------------------------------------------------------------------
# Grundlagen (jetzt nötig)
# ---------------------------------------------------------------------------

# Öffentliche Adresse, genau so wie sie im Browser steht (ohne / am Ende).
PUBLIC_URL=https://finanzen.example.org

# Passwort der Datenbank. Nur Buchstaben und Ziffern, weil es in einer URL steht:
#   openssl rand -hex 32
POSTGRES_PASSWORD=

# Port und Zeitzone stehen in compose.yml (PORT=43651, TZ=Europe/Berlin).
# Für die lokale Entwicklung ohne Compose:
# PORT=43651
# DATABASE_URL=postgresql://finanzen:<passwort>@127.0.0.1:5432/finanzen
# DATA_DIR=./data

# ---------------------------------------------------------------------------
# Sicherheit (jetzt nötig)
# ---------------------------------------------------------------------------

# Signiert die Session-Cookies. Ändern meldet alle ab.
#   openssl rand -base64 32
SESSION_KEY=

# Verschlüsselt gespeicherte Bank-PINs (AES-256-GCM). Nur nötig, wenn du PINs
# speichern willst (automatischer nächtlicher Abruf).
# NIE ändern und gut aufheben – ohne diesen Schlüssel sind gespeicherte PINs
# verloren (auch im Backup). 32 Byte als Base64:
#   openssl rand -base64 32
SECRETS_KEY=

# Nur auf true setzen, wenn die App hinter einem Reverse Proxy (NPM) läuft,
# damit X-Forwarded-For/-Proto ausgewertet werden.
TRUSTED_PROXY=true

# ---------------------------------------------------------------------------
# Login über OIDC – Pocket ID (jetzt nötig)
# ---------------------------------------------------------------------------
# In Pocket ID einen OIDC-Client „finanzen“ anlegen:
#   Callback-URL:  ${PUBLIC_URL}/auth/callback
#   Public Client mit PKCE
#   „Allowed User Groups“: nur die Gruppe eures Haushalts

OIDC_ISSUER=https://id.example.org
OIDC_CLIENT_ID=
# Leer lassen bei einem öffentlichen Client (PKCE).
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email groups
# Mitglieder dieser Gruppe sehen die Admin-Funktionen (Einstellungen, Backup).
OIDC_ADMIN_GROUP=admins
# Name des Anbieters auf dem Anmeldeknopf.
OIDC_PROVIDER_NAME=Kanonenwiese SSO
# Profilbilder werden nur vom Host des Issuers geladen. Weitere erlaubte Hosts,
# kommagetrennt:
# AVATAR_HOSTS=

# Nur für die lokale Entwicklung: Anmeldung ohne Identity Provider.
# NIEMALS in Produktion.
# DEV_LOGIN=true

# ---------------------------------------------------------------------------
# Bankanbindung FinTS (jetzt aktiv)
# ---------------------------------------------------------------------------

# Registrierungsnummer der Deutschen Kreditwirtschaft (Produktregistrierung,
# Kategorie „Web-Server“). Ohne sie ist kein FinTS-Abruf möglich.
FINTS_PRODUCT_ID=
# Automatischer Abruf für Bankzugänge mit gespeicherter PIN (Cron, Europe/Berlin).
FINTS_SYNC_SCHEDULE=15 5 * * *

# ---------------------------------------------------------------------------
# Kurse (jetzt aktiv)
# ---------------------------------------------------------------------------

# Täglicher Abruf von Kursen (onvista/Yahoo) und Wechselkursen (EZB), Cron in
# Europe/Berlin. Standard: werktags 23:30, nach Börsenschluss in den USA.
PRICE_SYNC_SCHEDULE=30 23 * * 1-5
# Ab wie vielen Handelstagen ohne neuen Kurs ein Wert als veraltet gilt.
PRICE_STALE_DAYS=3
# Hintergrundjobs ausschalten (z. B. für eine zweite Testinstanz).
# SCHEDULER=false
# onvista und Yahoo Finance brauchen keinen Schlüssel. Weitere Anbieter folgen, z. B.:
# EODHD_API_KEY=
# TWELVEDATA_API_KEY=
# COINGECKO_API_KEY=

# ---------------------------------------------------------------------------
# Backup (jetzt aktiv)
# ---------------------------------------------------------------------------

# Tägliche Sicherung aller Daten als JSON nach /data/backup (Cron, Europe/Berlin).
BACKUP_SCHEDULE=30 3 * * *
# Aufbewahrung in Tagen.
BACKUP_KEEP_DAYS=30

# ---------------------------------------------------------------------------
# Benachrichtigungen (jetzt aktiv)
# ---------------------------------------------------------------------------
# Was wer bekommt, stellt jede Person unter Einstellungen ein. Ohne SMTP gibt
# es keine E-Mails, ohne VAPID-Schlüssel keine Push-Nachrichten.

# E-Mail über SMTP (Monatsbericht, Warnungen).
SMTP_HOST=
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Finanzen <finanzen@example.org>

# Web-Push (VAPID). Schlüsselpaar einmal erzeugen und beide Zeilen übernehmen:
#   docker compose run --rm app python -m finanzen vapid
# Einmal gesetzt nicht mehr ändern, sonst müssen sich alle Geräte neu für
# Benachrichtigungen anmelden. VAPID_SUBJECT: Kontaktadresse für die
# Push-Dienste (mailto: oder https://).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org

# Monatsbericht am 1. jedes Monats (Cron, Europe/Berlin).
REPORT_SCHEDULE=0 8 1 * *
# Tägliche Prüfung auf auslaufende Festgelder, fällige Bewertungen und große
# Wertveränderungen (Cron, Europe/Berlin).
NOTIFY_SCHEDULE=0 8 * * *

# ---------------------------------------------------------------------------
# Sonstiges
# ---------------------------------------------------------------------------

# debug | info | warning | error
LOG_LEVEL=info
